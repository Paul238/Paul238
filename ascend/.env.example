# Copiază acest fișier ca ".env" și schimbă parolele (scripts\setup.ps1 face asta automat).

# portul pe care deschizi aplicația: http://localhost:8080
APP_PORT=8080
# portul phpMyAdmin (doar dacă pornești profilul "tools")
PMA_PORT=8081

DB_NAME=ascend
DB_USER=ascend
DB_PASSWORD=schimba-aceasta-parola
DB_ROOT_PASSWORD=schimba-si-aceasta-parola

# după ce ți-ai creat contul, poți pune false ca nimeni altcineva să nu-și facă cont
ALLOW_REGISTRATION=true
